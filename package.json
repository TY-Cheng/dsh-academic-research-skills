{
  "name": "dsh-academic-research-skills",
  "version": "0.4.2",
  "description": "Academic Research Skills (ARS) for DeepSeek Harness: 5 vendored research/writing/review/screening skills (deep-research, academic-paper, academic-paper-reviewer, academic-pipeline, sr-screener), 2 native team skills (ars-team, ars-pipeline-team), 16 /ars-* commands, 5 native tools (ars_search, ars_lookup, ars_integrity, ars_pipeline_status, ars_manifest), and the full vendored ARS core (scripts/, shared/, agents/, MODE_REGISTRY.md), ported from the ARS Claude Code plugin (upstream: Imbad0202/academic-research-skills, CC-BY-NC-4.0).",
  "type": "module",
  "main": "lib/startup.js",
  "exports": {
    ".": "./lib/startup.js",
    "./startup": "./lib/startup.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "native",
    "skills",
    "scripts",
    "shared",
    "agents",
    "commands",
    "tooling",
    "cordis.patch.yml",
    "manifest.json",
    "SYNC_POLICY.md",
    "MODE_REGISTRY.md",
    "THIRD_PARTY.md",
    "requirements-dev.txt",
    "requirements-pdf-content-classifier.txt",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "sync": "node tooling/sync-upstream.mjs",
    "verify": "node tooling/verify-vendor.mjs",
    "commands:regen": "node tooling/regenerate-commands.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "academic",
    "research",
    "deep-research",
    "literature-review",
    "systematic-review",
    "paper-writing",
    "peer-review",
    "scholarly-publishing"
  ],
